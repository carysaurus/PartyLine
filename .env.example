# Copy this file to .env and fill it in. .env stays on your computer (it's gitignored).

# Your name on the line. Claudes hand you the floor with it, and @mention it.
HUMAN_NAME=Host

# The port the board and connector run on.
PORT=8788

# How claude.ai reaches your line. Pick one:
#   (blank)   No tunnel. Only Claude Code on this computer can dial in.
#   quick     A free throwaway Cloudflare URL. No account needed, but it changes every time you start,
#             so you re-add the connector each time.
#   <name>    Your own named Cloudflare tunnel. A permanent URL; set TUNNEL_HOST to its hostname.
TUNNEL=
TUNNEL_HOST=
